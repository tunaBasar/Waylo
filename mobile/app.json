{
  "expo": {
    "name": "Waylo",
    "slug": "waylo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/waylo-icon.png",
    "scheme": "waylo",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.waylo.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "associatedDomains": ["applinks:waylo.example.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.waylo.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#004AC6",
        "foregroundImage": "./assets/images/waylo-adaptive-foreground.png",
        "monochromeImage": "./assets/images/waylo-adaptive-monochrome.png"
      },
      "permissions": ["POST_NOTIFICATIONS"],
      "blockedPermissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO", "android.permission.SYSTEM_ALERT_WINDOW"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "waylo.example.com", "pathPrefix": "/order/" },
            { "scheme": "https", "host": "waylo.example.com", "path": "/verify" },
            { "scheme": "https", "host": "waylo.example.com", "path": "/reset-password" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/waylo-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/waylo-splash.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        { "icon": "./assets/images/waylo-adaptive-monochrome.png", "color": "#004AC6" }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
