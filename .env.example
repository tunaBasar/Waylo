MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-app-password-without-spaces

# Base64-encoded HMAC key, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48

# Shared secret for service-to-service /internal calls. Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=replace-with-output-of-openssl-rand-hex-32

# Optional: creates/promotes this platform ADMIN on auth-service startup (also used by scripts/seed-data.sh)
WAYLO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
WAYLO_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
