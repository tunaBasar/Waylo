MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-app-password-without-spaces

# Base64-encoded HMAC key, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48

# Per-service Ed25519 identities (X-Service-Token). Do not edit by hand: run python3 scripts/gen-service-keys.py,
# which appends WAYLO_SERVICE_PRIVATE_KEY_<SERVICE> / WAYLO_SERVICE_KEYS_<SERVICE> for every service.
# Service calls are signed-token only (the shared INTERNAL_API_TOKEN is retired).

# Optional: creates/promotes this platform ADMIN on auth-service startup (also used by scripts/seed-data.sh)
WAYLO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
WAYLO_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Postgres superuser password used by the docker-compose postgres container and all services (SPRING_DATASOURCE_PASSWORD). Pick any strong value.
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# pgAdmin web login password (docker-compose pgadmin container).
PGADMIN_PASSWORD=replace-with-a-strong-pgadmin-password

# HMAC key for QR voucher codes (package-booking-service), min 32 chars.
VOUCHER_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# HTTP basic credentials for Eureka (discovery-service) and config-service. Every service uses them.
# docker-compose falls back to dev-only defaults if unset: always set real values outside local dev.
EUREKA_USER=eureka
EUREKA_PASSWORD=replace-with-a-strong-password
CONFIG_USER=config
CONFIG_PASSWORD=replace-with-a-strong-password

# Comma-separated browser origins allowed by api-gateway CORS (default: web 3000 + Expo web 8081)
WAYLO_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Optional: HMAC key for flight offer ids (flight-seat-inventory-service). Defaults to VOUCHER_SECRET.
# FLIGHT_OFFER_SECRET=replace-with-output-of-openssl-rand-hex-32
